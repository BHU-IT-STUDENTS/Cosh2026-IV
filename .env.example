# Public browser settings from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only key. Never prefix this with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional dedicated server-only key for stable legacy QR-card support. If
# omitted, the server securely derives this from SUPABASE_SERVICE_ROLE_KEY.
QR_SIGNING_SECRET=YOUR_LONG_RANDOM_SECRET

# Public HTTPS deployment address, used in QR verification URLs.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
